+}
+
+// A locked page loses its scrollbar; its width (--scrollbar-size, set by the script that locks) is kept clear so nothing
+// shifts. A margin, not padding: the body clips at its own edge, so nothing that overhangs the page shows in that strip
+html.is-scroll-locked {
+  overflow: clip;
+  body { margin-right: var(--scrollbar-size, 0); }
+}
