 // 05-components/_buttons.less — Bootstrap buttons re-themed via --bs-btn-*
 
+// A click presses the button to 97%, but only its plate (::after: the fill, and the ring on .btn), drawn in by a clip.
+// Scaled along with it, the label and icon are drawn afresh as the press settles and again as it ends, and hop a pixel
+// wherever the root or the display is scaled; a layer of their own stops the hop but leaves them soft at rest. A clip
+// moves by fractions of a pixel (an inset steps in whole ones, which read as a snap) and takes no layer, so the label
+// keeps its sharp edges. The fill is --btn-plate, never a background on the button itself, which would sit still behind it
+// It goes in on a plain ease-out over --duration-base and settles back out over --duration-slow: the first version ran both
+// ways on --ease-out, most of the move inside the first 70ms, which read as a snap
+.press-plate() {
+  --press-time: var(--duration-slow);
+  --press-ease: var(--ease-settle);
+  position: relative;
+  isolation: isolate;
+  &::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    background-color: var(--btn-plate);
+    clip-path: inset(-0.0625rem); // a pixel clear of the plate at rest, so its own edges are drawn, not the clip's
+  }
+  &:not(:disabled, .disabled, .is-disabled):active {
+    --press-time: var(--duration-base);
+    --press-ease: ease-out;
+    &::after { clip-path: ~"inset(max(1.5%, 0.09375rem))"; } // 1.5 at least, or a square arrow barely moves
+  }
+}
